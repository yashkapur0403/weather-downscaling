# Copy to `.env` and fill in only what you need. The product runs with EMPTY keys:
#   - advisory falls back to the deterministic rule template (message_source="template")
#   - /api/explain falls back to provider="rules"
#   - /api/translate returns the English text unchanged
#
# cp .env.example .env

# ---- Optional LLM / translation providers -------------------------------
GROQ_API_KEY=
SARVAM_API_KEY=

# Ordered Groq fallback chain (comma separated).
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# ---- Server behaviour ----------------------------------------------------
# Comma-separated browser origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 1 = run live U-Net inference for dates outside the committed grid
#     (requires torch + data/processed/X_*.npy; off by default).
ENABLE_LIVE_INFERENCE=0

# 1 = refuse to answer unless the location is Panchayat-exact (no block/district centroid).
REQUIRE_EXACT_LOCATION=0

# Override the repo root the backend reads artefacts from (defaults to the parent of backend/).
# REPO_ROOT=
